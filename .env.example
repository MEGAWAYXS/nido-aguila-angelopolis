# Copia este archivo como .env.local (no se sube a Git).
# Sin estas variables la app arranca en MODO DEMOSTRACIÓN con datos ficticios.

# URL del proyecto Supabase (Settings > API > Project URL)
VITE_SUPABASE_URL=

# Clave pública "anon"/"publishable" (Settings > API). Es pública por diseño:
# la seguridad depende de las políticas RLS. NUNCA pongas aquí la service_role.
VITE_SUPABASE_ANON_KEY=

# Ruta base para GitHub Pages: "/<nombre-del-repositorio>/". En local: "/"
VITE_BASE_PATH=/
